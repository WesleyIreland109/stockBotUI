{
  "name": "stockbot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://stockbotapp.com",
  "scripts": {
    "dev": "vite",
    "api": "node server.js",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "express": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.9.2",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.2.0",
    "vite": "^7.0.0"
  }
}
